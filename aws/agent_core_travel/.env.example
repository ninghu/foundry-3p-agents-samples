# AWS / Bedrock
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ADOT Collector (app → collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Azure Monitor (collector → App Insights)
# Parse these from your APPLICATION_INSIGHTS_CONNECTION_STRING:
#   InstrumentationKey=<IKEY>;IngestionEndpoint=<ENDPOINT>;...
AZURE_MONITOR_OTLP_ENDPOINT=https://eastus2-3.in.applicationinsights.azure.com
AZURE_MONITOR_IKEY=<your-instrumentation-key>

# Agent identity
AGENT_NAME=aws-travel-planner-agent
AGENT_ID=aws-agentcore-travel-planner
