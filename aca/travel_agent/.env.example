# --- Azure OpenAI configuration ---
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-52
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Azure Application Insights (tracing) ---
# IMPORTANT: OTEL_AGENT_ID must match the "OpenTelemetry Agent ID"
# value you enter when registering this agent in Microsoft Foundry.
APPLICATION_INSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://region-0.in.applicationinsights.azure.com/
OTEL_AGENT_ID=aca-travel-planner
APPLICATION_INSIGHTS_ENABLE_CONTENT=true

# --- Azure Container Apps deployment (used by deploy.py) ---
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_LOCATION=eastus
ACR_NAME=youracr
ACA_ENVIRONMENT_NAME=aca-agents-env
ACA_APP_NAME=aca-travel-planner

# --- Optional overrides ---
# OTEL_SERVICE_NAME=nested-travel-sample
# OTEL_GENAI_PROVIDER=azure
# HOST=0.0.0.0
# PORT=8080
